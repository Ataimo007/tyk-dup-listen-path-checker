# Copy this file to .env and fill in your values.
# Never commit the real .env — it's already listed in .gitignore.

# Base URL of your Tyk Dashboard (no trailing slash), e.g.:
# TYK_DASHBOARD_URL=https://dashboard.your-company.com
TYK_DASHBOARD_URL=

# Dashboard API access key for a user with at least read access to APIs.
# Find it under Dashboard > User Profile > API Access Credentials.
TYK_DASHBOARD_API_KEY=
